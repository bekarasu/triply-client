# Sample environment file
# Copy this file to .env and update the values for your local development

# Service URLs
EXPO_PUBLIC_RECOMMENDATION_SERVICE_URL=http://localhost:3001/recommendation-service
EXPO_PUBLIC_USER_SERVICE_URL=http://localhost:3002/user-service
EXPO_PUBLIC_TRAVEL_SERVICE_URL=http://localhost:3003/travel-service

# API Configuration
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_ENABLE_NETWORK_MONITOR=false

# Google Maps SDK for Android key (restrict it to package com.bekarasu.triply + your SHA-1)
# Read by app.config.js at build time; iOS uses Apple Maps and needs no key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
