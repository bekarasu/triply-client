{
	"cli": {
		"version": ">= 16.28.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"distribution": "internal",
			"environment": "development",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_PUBLIC_RECOMMENDATION_SERVICE_URL": "http://192.168.1.102:3001/recommendation",
				"EXPO_PUBLIC_USER_SERVICE_URL": "http://192.168.1.102:3002/user",
				"EXPO_PUBLIC_TRAVEL_SERVICE_URL": "http://192.168.1.102:3003/travel",
				"EXPO_PUBLIC_ENABLE_NETWORK_MONITOR": "true",
				"EXPO_PUBLIC_API_TIMEOUT": "60000",
				"EXPO_PUBLIC_NODE_ENV": "development"
			}
		}
	}
}