{
  "name": "triply",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "dotenv -e .env.development -- expo start --port 8082",
    "start:dev": "dotenv -e .env.development -- expo start --port 8082",
    "start:staging": "dotenv -e .env.staging -- expo start --port 8082",
    "start:prod": "dotenv -e .env.production -- expo start --port 8082",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "dotenv -e .env.development -- expo start --android --port 8082",
    "android:dev": "dotenv -e .env.development -- expo start --android --port 8082",
    "android:staging": "dotenv -e .env.staging -- expo start --android --port 8082",
    "android:prod": "dotenv -e .env.production -- expo start --android --port 8082",
    "ios": "dotenv -e .env.development -- expo start --ios --port 8082",
    "ios:dev": "dotenv -e .env.development -- expo start --ios --port 8082",
    "ios:staging": "dotenv -e .env.staging -- expo start --ios --port 8082",
    "ios:prod": "dotenv -e .env.production -- expo start --ios --port 8082",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:android": "node ./scripts/build.js --env development --platform android --local",
    "build:android:dev": "npx eas build --profile development --platform android --local",
    "build:android:bundle": "expo build:android -t app-bundle",
    "build:ios": "expo build:ios",
    "build": "node ./scripts/build.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^57.0.23",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keychain": "^10.0.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "baseline-browser-mapping": "^2.10.16",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
